sfml: "v0.1"
description: >
  Turns a rough idea into a published post.
start: draft
budget: 20.00
parameters:
  topic:
    type: string
    description: What to write about.

steps:
  draft:
    type: agent
    harness: claude-agent-sdk
    prompt_path: prompts/draft.md
    prompt_vars:
      topic: parameters.topic
      notes: last(results.review).notes
    max_iterations: 5
    result_schema:
      type: object
      required: [draft_path]
      properties:
        draft_path: { type: string }
    next:
      - to: review

  review:
    type: human
    assignee: "editor"
    instructions: "'Read the draft and decide whether it is ready to publish.'"
    max_iterations: 5
    result_schema:
      type: object
      required: [decision]
      properties:
        decision: { type: string, enum: [approve, revise] }
        notes: { type: string }
    next:
      - when: "last(results.review).decision == 'revise'"
        to: draft
      - to: publish

  publish:
    type: agent
    harness: claude-agent-sdk
    prompt_path: prompts/publish.md
    prompt_vars:
      draft_path: last(results.draft).draft_path
    max_iterations: 3
    result_schema:
      type: object
      required: [ok]
      properties:
        ok: { type: boolean }
    next:
      - to: success

  success:
    type: result
    outcome: complete
    value: last(results.publish)
