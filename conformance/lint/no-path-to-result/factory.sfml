sfml: "v0.1"
start: review
steps:
  review:
    type: human
    result_schema: { type: object, required: [approved], properties: { approved: { type: boolean } } }
    next:
      - when: last(results.review).approved
        to: done
      - to: trap
  trap:
    type: human
    max_iterations: 2
    result_schema: { type: object }
    next:
      - to: trap
  done:
    type: result
    outcome: complete
