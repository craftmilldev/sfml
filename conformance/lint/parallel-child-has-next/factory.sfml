sfml: "v0.1"
start: checks
steps:
  checks:
    type: parallel
    steps:
      design:
        type: human
        result_schema: { type: object }
      security:
        type: human
        result_schema: { type: object }
        next:
          - to: done
    next:
      - to: done
  done:
    type: result
    outcome: complete
