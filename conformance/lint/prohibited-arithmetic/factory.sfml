sfml: "v0.1"
start: review
steps:
  review:
    type: human
    result_schema: { type: object, required: [score], properties: { score: { type: integer } } }
    next:
      - when: last(results.review).score + 1 > 3
        to: done
      - to: rejected
  done:
    type: result
    outcome: complete
  rejected:
    type: result
    outcome: terminal_failure
