sfml: "v0.1"
start: review
steps:
  review:
    type: human
    result_schema: { type: object, required: [notes], properties: { notes: { type: string } } }
    next:
      - to: fix
  fix:
    type: agent
    harness: mock
    harness_config: { agent: fixer }
    prompt: "Address this review: ««last(results.review).notes»»"
    result_schema: { type: object }
    next:
      - to: done
  done:
    type: result
    outcome: complete
