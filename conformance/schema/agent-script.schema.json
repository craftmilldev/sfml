{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfml.dev/conformance/schema/agent-script.schema.json",
  "title": "Mock agent script (agents/<agent>.yaml)",
  "description": "The ordered sessions one named agent plays back. The nth session a Runner opens for this agent plays sessions[n-1]; the mth turn on a session plays turns[m-1] (mock-harness.md §4, §6).",
  "type": "object",
  "additionalProperties": false,
  "required": ["mock", "agent", "sessions"],
  "properties": {
    "mock": { "const": "0.1" },
    "agent": { "$ref": "#/$defs/AgentName" },
    "description": { "type": "string" },
    "sessions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Session" } }
  },
  "$defs": {
    "AgentName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "ModelName": { "type": "string", "pattern": "^mock-[a-z0-9-]+$" },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "turns"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/ModelName" },
        "turns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Turn" } }
      }
    },
    "Turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "step": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string" }
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ScriptEvent" },
          "description": "Exactly one terminal event (complete | fail), and it is last. Checked by tools/validate.mjs."
        }
      }
    },
    "TokenCount": { "type": "integer", "minimum": 0 },
    "ScriptEvent": {
      "oneOf": [
        { "$ref": "#/$defs/MessageEvent" },
        { "$ref": "#/$defs/ReasoningEvent" },
        { "$ref": "#/$defs/ToolCallEvent" },
        { "$ref": "#/$defs/ToolResultEvent" },
        { "$ref": "#/$defs/UsageEvent" },
        { "$ref": "#/$defs/BarrierEvent" },
        { "$ref": "#/$defs/CompleteEvent" },
        { "$ref": "#/$defs/FailEvent" }
      ]
    },
    "MessageEvent": {
      "type": "object", "additionalProperties": false, "required": ["message"],
      "properties": { "message": { "type": "string" } }
    },
    "ReasoningEvent": {
      "type": "object", "additionalProperties": false, "required": ["reasoning"],
      "properties": { "reasoning": { "type": "string" } }
    },
    "ToolCallEvent": {
      "type": "object", "additionalProperties": false, "required": ["tool_call"],
      "properties": {
        "tool_call": {
          "type": "object", "additionalProperties": false, "required": ["id", "name", "input"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "input": {}
          }
        }
      }
    },
    "ToolResultEvent": {
      "type": "object", "additionalProperties": false, "required": ["tool_result"],
      "properties": {
        "tool_result": {
          "type": "object", "additionalProperties": false, "required": ["id", "output"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "output": {},
            "is_error": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "UsageEvent": {
      "type": "object", "additionalProperties": false, "required": ["usage"],
      "properties": {
        "usage": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "model": { "$ref": "#/$defs/ModelName" },
            "input_tokens": { "$ref": "#/$defs/TokenCount" },
            "output_tokens": { "$ref": "#/$defs/TokenCount" },
            "cache_read_tokens": { "$ref": "#/$defs/TokenCount" },
            "cache_write_tokens": { "$ref": "#/$defs/TokenCount" }
          }
        }
      }
    },
    "BarrierEvent": {
      "type": "object", "additionalProperties": false, "required": ["barrier"],
      "properties": { "barrier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" } }
    },
    "CompleteEvent": {
      "type": "object", "additionalProperties": false, "required": ["complete"],
      "properties": {
        "complete": {
          "type": "object", "additionalProperties": false, "required": ["output"],
          "properties": { "output": { "description": "Any JSON value; the Runner validates it against result_schema." } }
        }
      }
    },
    "FailEvent": {
      "type": "object", "additionalProperties": false, "required": ["fail"],
      "properties": {
        "fail": {
          "type": "object", "additionalProperties": false, "required": ["message", "retryable"],
          "properties": {
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "backoff_ms": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
