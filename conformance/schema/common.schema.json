{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfml.dev/conformance/schema/common.schema.json",
  "title": "Definitions shared by the conformance schemas",
  "$defs": {
    "Description": { "type": "string", "minLength": 1 },
    "Clauses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^§[0-9]+(\\.[0-9]+)*$" }
    },
    "AgentName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "ModelName": { "type": "string", "pattern": "^mock-[a-z0-9-]+$" }
  }
}
