{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfml.dev/conformance/schema/result.schema.json",
  "title": "Runner case result file (expect/result.yaml)",
  "description": "How the run stands after the last drive action (conformance/README.md §3.3).",
  "oneOf": [
    {
      "title": "Rejected at admission",
      "type": "object",
      "additionalProperties": false,
      "required": ["admission"],
      "properties": { "admission": { "const": "rejected" } }
    },
    {
      "title": "Terminal",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "value"],
      "properties": {
        "outcome": { "enum": ["complete", "terminal_failure"] },
        "value": { "description": "The result step's value (SPEC §6.8)." }
      }
    },
    {
      "title": "Blocked",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocked"],
      "properties": {
        "status": { "enum": ["errored", "awaiting_input"] },
        "blocked": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "case.schema.json#/$defs/Blocked" }
        }
      }
    }
  ]
}
