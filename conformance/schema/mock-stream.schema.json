{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfml.dev/conformance/schema/mock-stream.schema.json",
  "title": "Mock harness wire shapes",
  "description": "TurnRequest is what a Runner passes to MockHarness.run(); Event is each item of the async stream it returns (mock-harness.md §3, §5).",
  "$defs": {
    "SessionId": { "type": "string", "pattern": "^mock:[a-z0-9][a-z0-9_-]{0,63}:[1-9][0-9]*$" },
    "ModelName": { "type": "string", "pattern": "^mock-[a-z0-9-]+$" },
    "Usd": {
      "description": "Exact USD as a decimal string with exactly 8 fractional digits (1e-8 USD units).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{8}$"
    },
    "TokenCount": { "type": "integer", "minimum": 0 },

    "TurnRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "prompt", "harness_config"],
      "properties": {
        "step": { "type": "string", "minLength": 1, "description": "Qualified step name (SPEC §5.3). Diagnostic only." },
        "prompt": { "type": "string", "description": "The rendered prompt (SPEC §9.9)." },
        "harness_config": { "type": "object", "description": "Passed through unexamined; the mock validates it (mock-harness.md §2.2)." },
        "output_schema": { "type": "object", "description": "The step's result_schema. Informative; the mock does not enforce it." },
        "resume": { "$ref": "#/$defs/SessionId" }
      }
    },

    "Envelope": {
      "type": "object",
      "required": ["type", "session_id", "turn", "seq"],
      "properties": {
        "type": { "type": "string" },
        "session_id": { "oneOf": [{ "$ref": "#/$defs/SessionId" }, { "type": "null" }] },
        "turn": { "type": "integer", "minimum": 0 },
        "seq": { "type": "integer", "minimum": 0 }
      }
    },

    "ModelUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "cost_usd"],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/TokenCount" },
        "output_tokens": { "$ref": "#/$defs/TokenCount" },
        "cache_read_tokens": { "$ref": "#/$defs/TokenCount" },
        "cache_write_tokens": { "$ref": "#/$defs/TokenCount" },
        "cost_usd": { "$ref": "#/$defs/Usd" }
      }
    },
    "UsageRollup": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/ModelName" },
      "additionalProperties": { "$ref": "#/$defs/ModelUsage" }
    },

    "Event": {
      "oneOf": [
        { "$ref": "#/$defs/SessionStarted" },
        { "$ref": "#/$defs/TurnStarted" },
        { "$ref": "#/$defs/Message" },
        { "$ref": "#/$defs/Reasoning" },
        { "$ref": "#/$defs/ToolCall" },
        { "$ref": "#/$defs/ToolResult" },
        { "$ref": "#/$defs/Usage" },
        { "$ref": "#/$defs/TurnCompleted" },
        { "$ref": "#/$defs/TurnFailed" }
      ]
    },

    "SessionStarted": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "unevaluatedProperties": false,
      "required": ["agent", "model"],
      "properties": {
        "type": { "const": "session.started" },
        "agent": { "type": "string" },
        "model": { "$ref": "#/$defs/ModelName" }
      }
    },
    "TurnStarted": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "unevaluatedProperties": false,
      "required": ["resumed"],
      "properties": {
        "type": { "const": "turn.started" },
        "resumed": { "type": "boolean" }
      }
    },
    "Message": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "unevaluatedProperties": false,
      "required": ["text"],
      "properties": { "type": { "const": "message" }, "text": { "type": "string" } }
    },
    "Reasoning": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "unevaluatedProperties": false,
      "required": ["text"],
      "properties": { "type": { "const": "reasoning" }, "text": { "type": "string" } }
    },
    "ToolCall": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "unevaluatedProperties": false,
      "required": ["call_id", "name", "input"],
      "properties": {
        "type": { "const": "tool.call" },
        "call_id": { "type": "string" },
        "name": { "type": "string" },
        "input": {}
      }
    },
    "ToolResult": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "unevaluatedProperties": false,
      "required": ["call_id", "output", "is_error"],
      "properties": {
        "type": { "const": "tool.result" },
        "call_id": { "type": "string" },
        "output": {},
        "is_error": { "type": "boolean" }
      }
    },
    "Usage": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "unevaluatedProperties": false,
      "required": ["model", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "cost_usd", "turn_cost_usd"],
      "properties": {
        "type": { "const": "usage" },
        "model": { "$ref": "#/$defs/ModelName" },
        "input_tokens": { "$ref": "#/$defs/TokenCount" },
        "output_tokens": { "$ref": "#/$defs/TokenCount" },
        "cache_read_tokens": { "$ref": "#/$defs/TokenCount" },
        "cache_write_tokens": { "$ref": "#/$defs/TokenCount" },
        "cost_usd": { "$ref": "#/$defs/Usd", "description": "A consumption report: what this event cost." },
        "turn_cost_usd": { "$ref": "#/$defs/Usd", "description": "Running total for the turn, including this event." }
      }
    },
    "TurnCompleted": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "unevaluatedProperties": false,
      "required": ["output", "total_cost_usd", "usage"],
      "properties": {
        "type": { "const": "turn.completed" },
        "output": { "description": "Candidate StepResult; any JSON value." },
        "total_cost_usd": { "$ref": "#/$defs/Usd", "description": "Summary of this turn's usage events. Not a new report." },
        "usage": { "$ref": "#/$defs/UsageRollup" }
      }
    },
    "TurnFailed": {
      "allOf": [{ "$ref": "#/$defs/Envelope" }],
      "unevaluatedProperties": false,
      "required": ["error", "total_cost_usd", "usage"],
      "properties": {
        "type": { "const": "turn.failed" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message", "retryable"],
          "properties": {
            "message": { "type": "string" },
            "retryable": { "type": "boolean" },
            "backoff_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "total_cost_usd": { "$ref": "#/$defs/Usd" },
        "usage": { "$ref": "#/$defs/UsageRollup" }
      }
    }
  }
}
