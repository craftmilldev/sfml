{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfml.dev/conformance/schema/case.schema.json",
  "title": "Conformance case manifest (case.yaml)",
  "description": "See conformance/README.md §1–§3.",
  "oneOf": [
    { "$ref": "#/$defs/ParserCase" },
    { "$ref": "#/$defs/LintCase" },
    { "$ref": "#/$defs/RunnerCase" }
  ],
  "$defs": {
    "Clause": { "type": "string", "pattern": "^§[0-9]+(\\.[0-9]+)*$" },
    "Common": {
      "type": "object",
      "required": ["class", "description", "clauses"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "clauses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Clause" } }
      }
    },

    "ParserCase": {
      "allOf": [{ "$ref": "#/$defs/Common" }],
      "unevaluatedProperties": false,
      "required": ["expect"],
      "properties": {
        "class": { "const": "parser" },
        "expect": { "enum": ["accept", "reject"] }
      }
    },

    "DiagnosticId": {
      "enum": [
        "unknown-step-reference",
        "invalid-parallel-child-type",
        "parallel-child-has-next",
        "nested-parallel",
        "field-not-applicable-to-type",
        "non-total-routing",
        "unreachable-step",
        "no-path-to-result",
        "unbounded-cycle",
        "unknown-parameter-reference",
        "unknown-step-result-reference",
        "unreachable-reference",
        "binding-environment-violation"
      ]
    },
    "LintCase": {
      "allOf": [{ "$ref": "#/$defs/Common" }],
      "unevaluatedProperties": false,
      "required": ["expect"],
      "properties": {
        "class": { "const": "lint" },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diagnostics"],
          "properties": {
            "diagnostics": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/DiagnosticId" } }
          }
        }
      }
    },

    "RunnerCase": {
      "allOf": [{ "$ref": "#/$defs/Common" }],
      "unevaluatedProperties": false,
      "required": ["drive"],
      "properties": {
        "class": { "const": "runner" },
        "unscripted_agents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" }
        },
        "drive": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Action" } }
      }
    },

    "Action": {
      "oneOf": [
        { "$ref": "#/$defs/StartAction" },
        { "$ref": "#/$defs/ResumeAction" },
        { "$ref": "#/$defs/RestartAction" }
      ]
    },
    "StartAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "parameters": { "type": "object" } }
        },
        "expect": { "$ref": "#/$defs/StartExpect" }
      }
    },
    "ResumeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resume"],
      "properties": {
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step"],
          "properties": {
            "step": { "type": "string", "minLength": 1 },
            "payload": { "description": "Presence is significant: absent = no payload; null = the JSON value null." }
          }
        },
        "expect": { "$ref": "#/$defs/ResumeExpect" }
      }
    },
    "RestartAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restart"],
      "properties": {
        "restart": { "type": "object", "maxProperties": 0 },
        "expect": { "$ref": "#/$defs/RunExpect" }
      }
    },

    "RunExpectProps": {
      "type": "object",
      "properties": {
        "status": { "enum": ["errored", "awaiting_input", "terminal"] },
        "blocked": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Blocked" } },
        "state": { "$ref": "factory-state.schema.json" },
        "trace": { "$ref": "trace.schema.json" }
      }
    },
    "RunExpect": {
      "allOf": [{ "$ref": "#/$defs/RunExpectProps" }],
      "unevaluatedProperties": false
    },
    "StartExpect": {
      "allOf": [{ "$ref": "#/$defs/RunExpectProps" }],
      "unevaluatedProperties": false,
      "properties": { "admitted": { "type": "boolean" } }
    },
    "ResumeExpect": {
      "allOf": [{ "$ref": "#/$defs/RunExpectProps" }],
      "unevaluatedProperties": false,
      "properties": { "accepted": { "type": "boolean", "default": true } }
    },

    "ExceptionClass": {
      "enum": ["schema_violation", "harness_error", "iteration_limit", "budget_exceeded", "expression_error", "routing_error"]
    },
    "Blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "state"],
      "properties": {
        "step": { "type": "string", "minLength": 1 },
        "state": { "enum": ["errored", "awaiting_input"] },
        "exception": { "$ref": "#/$defs/ExceptionClass" }
      },
      "if": { "properties": { "state": { "const": "errored" } } },
      "then": { "required": ["exception"] },
      "else": { "not": { "required": ["exception"] } }
    }
  }
}
