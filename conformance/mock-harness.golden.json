{
  "description": "The exact stream a conforming mock emits for the first turn of runner/linear-prompt-rendering's planner script. Mock implementations can use it as a unit-test fixture; tools/validate.mjs re-derives it from the script and models.json.",
  "script": "runner/linear-prompt-rendering/agents/planner.yaml",
  "request": {
    "step": "plan",
    "prompt": "Plan «this» issue: add a --verbose flag (p2)",
    "harness_config": { "agent": "planner" },
    "output_schema": {
      "type": "object",
      "required": ["plan"],
      "properties": { "plan": { "type": "string" } }
    }
  },
  "events": [
    { "type": "session.started", "session_id": "mock:planner:1", "turn": 1, "seq": 0, "agent": "planner", "model": "mock-medium" },
    { "type": "turn.started", "session_id": "mock:planner:1", "turn": 1, "seq": 1, "resumed": false },
    { "type": "reasoning", "session_id": "mock:planner:1", "turn": 1, "seq": 2, "text": "The CLI parser lives in src/cli.ts." },
    { "type": "tool.call", "session_id": "mock:planner:1", "turn": 1, "seq": 3, "call_id": "t1", "name": "read_file", "input": { "path": "src/cli.ts" } },
    { "type": "tool.result", "session_id": "mock:planner:1", "turn": 1, "seq": 4, "call_id": "t1", "output": "export function parse(argv) { … }", "is_error": false },
    {
      "type": "usage", "session_id": "mock:planner:1", "turn": 1, "seq": 5,
      "model": "mock-medium",
      "input_tokens": 8000, "output_tokens": 1200, "cache_read_tokens": 4000, "cache_write_tokens": 0,
      "cost_usd": "0.04320000", "turn_cost_usd": "0.04320000"
    },
    { "type": "message", "session_id": "mock:planner:1", "turn": 1, "seq": 6, "text": "Plan ready." },
    {
      "type": "turn.completed", "session_id": "mock:planner:1", "turn": 1, "seq": 7,
      "output": { "plan": "add a --verbose flag to parse()" },
      "total_cost_usd": "0.04320000",
      "usage": {
        "mock-medium": { "input_tokens": 8000, "output_tokens": 1200, "cache_read_tokens": 4000, "cache_write_tokens": 0, "cost_usd": "0.04320000" }
      }
    }
  ]
}
