sfml: "v0.1"
start: fetch
steps:
  fetch:
    type: agent
    harness: mock
    harness_config: { agent: fetcher }
    prompt: "Fetch the deploy log."
    result_schema:
      type: object
      required: [lines]
      properties: { lines: { type: array, items: { type: string } } }
    next:
      - to: summarize
  summarize:
    type: agent
    harness: mock
    harness_config: { agent: summarizer }
    prompt_vars:
      lines: last(results.fetch).lines
    prompt: "Summarize, starting from: ««prompt_vars.lines[0]»»"
    result_schema:
      type: object
      required: [summary]
      properties: { summary: { type: string } }
    next:
      - to: done
  done:
    type: result
    outcome: complete
    value: last(results.summarize)
