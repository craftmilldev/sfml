sfml: "v0.1"
start: form
steps:
  form:
    type: human
    result_schema:
      type: object
      properties:
        urgent: { type: boolean }
        note: { type: string }
    next:
      - when: last(results.form).urgent
        to: review
      - to: done
  review:
    type: human
    instructions: last(results.form).note
    result_schema:
      type: object
      required: [approved]
      properties: { approved: { type: boolean } }
    next:
      - to: done
  done:
    type: result
    outcome: complete
