sfml: "v0.1"
start: first
budget: 0.01
steps:
  first:
    type: agent
    harness: mock
    harness_config: { agent: local-a }
    budget: 0.01
    prompt: "First."
    result_schema: { type: object, required: [n], properties: { n: { type: integer } } }
    next:
      - to: second
  second:
    type: agent
    harness: mock
    harness_config: { agent: local-b }
    budget: 0.01
    prompt: "Second."
    result_schema: { type: object, required: [n], properties: { n: { type: integer } } }
    next:
      - to: done
  done:
    type: result
    outcome: complete
