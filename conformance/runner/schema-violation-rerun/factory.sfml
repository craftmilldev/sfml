sfml: "v0.1"
start: draft
steps:
  draft:
    type: agent
    harness: mock
    harness_config: { agent: writer }
    retry: 1
    prompt: "Write a title."
    result_schema:
      type: object
      required: [title]
      properties: { title: { type: string } }
    next:
      - to: done
  done:
    type: result
    outcome: complete
    value: last(results.draft)
