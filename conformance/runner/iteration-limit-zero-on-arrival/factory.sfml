sfml: "v0.1"
start: review
steps:
  review:
    type: human
    max_iterations: 0
    result_schema:
      type: object
      required: [approved]
      properties: { approved: { type: boolean } }
    next:
      - to: done
  done:
    type: result
    outcome: complete
    value: last(results.review)
