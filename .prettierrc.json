{
  "printWidth": 120,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "none",
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "proseWrap": "always",
  "overrides": [
    {
      "files": "**/*.{md,mdx}",
      "options": {
        "tabWidth": 2,
        "printWidth": 100
      }
    }
  ]
}
